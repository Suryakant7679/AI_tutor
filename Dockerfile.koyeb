FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    AIOS_HOST=0.0.0.0 \
    PORT=8000

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates poppler-utils tesseract-ocr \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system aios \
    && useradd --system --gid aios --create-home --home-dir /home/aios aios

WORKDIR /app
COPY requirements.txt ./
RUN python -m pip install --upgrade pip \
    && python -m pip install -r requirements.txt

COPY --chown=aios:aios app ./app
COPY --chown=aios:aios migrations ./migrations
COPY --chown=aios:aios web ./web
COPY --chown=aios:aios deploy/koyeb-start.sh ./deploy/koyeb-start.sh
RUN mkdir -p /app/data/uploads /app/data/backups /app/data/worker_state \
    && python -c "from pathlib import Path; p=Path('/app/deploy/koyeb-start.sh'); p.write_bytes(p.read_bytes().replace(b'\r\n', b'\n'))" \
    && chmod +x /app/deploy/koyeb-start.sh \
    && chown -R aios:aios /app/data

USER aios
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=3).read()" || exit 1
CMD ["/app/deploy/koyeb-start.sh"]
