# Render runtime
AIOS_HOST=0.0.0.0
AIOS_STORAGE_BACKEND=postgres
AIOS_VECTOR_BACKEND=qdrant

# Supabase Session pooler URI; add sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Upstash TLS Redis URI.
REDIS_URL=rediss://default:PASSWORD@HOST:PORT
AIOS_REDIS_NAMESPACE=aios

# Qdrant Cloud
QDRANT_URL=https://YOUR-CLUSTER.REGION.CLOUD.QDRANT.IO:6333
QDRANT_API_KEY=REPLACE_WITH_QDRANT_API_KEY
QDRANT_COLLECTION=aios_embeddings

# Authentication and rate limits
AIOS_AUTH_REQUIRED=true
AIOS_ADMIN_EMAILS=you@example.com
AIOS_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
AIOS_JWT_ISSUER=aios
AIOS_JWT_AUDIENCE=aios-api
AIOS_JWT_TTL=3600
AIOS_API_RATE_LIMIT=120
AIOS_API_RATE_WINDOW=60
AIOS_CHAT_RATE_LIMIT=10
AIOS_CHAT_RATE_WINDOW=60
AIOS_MAX_UPLOAD_BYTES=5242880

# Configure at least one model provider.
AIOS_PROVIDER=gemini
GROQ_API_KEY=
AIOS_GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
AIOS_GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
AIOS_OPENAI_MODEL=gpt-4o-mini

# Free Koyeb local files are ephemeral.
AIOS_UPLOAD_DIR=data/uploads
AIOS_UPLOAD_INDEX=data/uploads.json
AIOS_MEMORY_FILE=data/memory.json
AIOS_OBSERVABILITY_FILE=data/observability.json

# Disable high-risk execution tools publicly.
AIOS_MCP_FILESYSTEM_WRITE=false
AIOS_MCP_IMAGE_WRITE=false
AIOS_MCP_REST_WRITE=false
AIOS_MCP_CUSTOM_ENABLED=false
